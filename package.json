{
	"name": "equail-api",
	"version": "1.0.0",
	"description": "The main backend api for equail.",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"dev": "tsx --env-file .env src/index.ts",
		"start": "node --env-file .env dist/index.js",
		"dev:stage": "tsx --env-file .env.staging src/index.ts",
		"start:stage": "node --env-file .env.staging dist/index.js",
		"build": "tsc --listEmittedFiles && tsc-alias --verbose",
		"format": "prettier --write ."
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"better-auth": "^1.6.0",
		"cloudflared": "^0.7.1",
		"cloudinary": "^2.9.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"multer": "^2.0.2",
		"mysql2": "^3.16.2",
		"nodemailer": "^7.0.13",
		"sequelize": "^6.37.7",
		"ws": "^8.19.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@tsconfig/node22": "^22.0.5",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.0.0",
		"@types/node": "^25.1.0",
		"@types/nodemailer": "^7.0.11",
		"@types/ws": "^8.18.1",
		"prettier": "^3.8.1",
		"tsc-alias": "^1.8.16",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	}
}
